      <aliases enabled='yes' />
      <column caption='Delivery Bucket' datatype='string' name='[Calculation_0781780540715008]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [delivery_days] &lt;= 3 THEN &quot;Fast (0-3 days)&quot;&#13;&#10;ELSEIF  [delivery_days] &lt;= 6 THEN &quot;Standard (4-6 days)&quot;&#13;&#10;ELSE &quot;Slow (7+ days)&quot;&#13;&#10;END' />
      </column>
      <column caption='Order Month' datatype='datetime' name='[Calculation_0781780541403137]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [order_date])' />
      </column>
      <column caption='Avg Order Value' datatype='real' name='[Calculation_0781780550561794]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([revenue])/COUNTD([order_id])' />
      </column>
